<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.wandall" name="Wandall" version="1.2.0" provider-name="WandallDev">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Wandall Live TV</summary>
        <description lang="en">Xtream Codes and M3U player with live TV, movies, shows, fast multi-threaded search, categorized watch history, and recommendations</description>
        <platform>all</platform>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
